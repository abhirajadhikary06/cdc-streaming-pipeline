# Neon PostgreSQL Source Configuration
NEON_DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require
NEON_HOST=<neon-host>
NEON_PORT=5432
NEON_DATABASE=<database>
NEON_USER=<user>
NEON_PASSWORD=<password>
NEON_SSLMODE=require

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CDC_TOPIC=neon_cdc.public.customer_transactions

# MinIO Lakehouse Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=cdc-lake